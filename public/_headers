# Cloudflare Pages headers
# HTML must always revalidate so an old homepage can never be served stale
# from cache. Hashed build assets are safe to cache forever.

/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Crawler-facing metadata. Same rule as HTML: these carry freshness signals
# (sitemap lastmod, llms.txt content), so a stale cached copy is worse than a
# revalidation round-trip.
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable
